# Dependencies (installed inside Docker, never copied)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build outputs (generated during `next build`)
.next/
out/
dist/
build/
.vercel/

# Local development and editor files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log

# Environment variables — pass secrets at runtime with `docker run -e`
.env
.env*.local
.env.development
.env.test
.env.production.local

# Docker configuration files
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*.yaml
docker-compose*.yml

# Documentation
README.md
*.md
docs/

# CI/CD configuration
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Cache directories and temporary data
.cache/
.eslintcache
.swc/
.turbo/
.tmp/
.temp/

# TypeScript build metadata
*.tsbuildinfo

# OS-specific files
.DS_Store
Thumbs.db

# AI tool metadata
.cursor/
.cursorrules
